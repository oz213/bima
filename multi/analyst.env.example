# Copy outside the Git checkout, e.g. /home/fauzi/.config/bima/analyst.env.
# Read README_BIMA_DOMAIN_ANALYST.md before choosing a provider.
# This example contains no credentials and does not enable the feature.
BIMA_ANALYST_ENABLED=0
BIMA_ANALYST_PROVIDER=disabled

# Optional existing learning database; never created by the analyst.
# BIMA_LEARNING_DB=/home/fauzi/crawler-rebuild/multi/state/bima_learning_v450.sqlite3

# OpenAI: all three settings are required, plus one credential source.
# BIMA_ANALYST_PROVIDER=openai
# BIMA_ANALYST_ALLOW_CLOUD=1
# BIMA_ANALYST_MODEL=REPLACE_WITH_AN_AVAILABLE_MODEL
# BIMA_ANALYST_OPENAI_KEY_FILE=/home/fauzi/.config/bima/openai.key
# Alternative to the key file: OPENAI_API_KEY (never configure both).

# Ollama: an already provisioned daemon/model, not installed by this patch.
# Daemon MUST disable cloud first (OLLAMA_NO_CLOUD=1), then restart it.
# BIMA_ANALYST_PROVIDER=ollama
# BIMA_ANALYST_MODEL=REPLACE_WITH_AN_INSTALLED_LOCAL_MODEL
# BIMA_ANALYST_OLLAMA_ORIGIN=http://127.0.0.1:11434
# BIMA_ANALYST_OLLAMA_LOCAL_ONLY=1
